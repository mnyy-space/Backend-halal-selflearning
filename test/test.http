# Then generate authenSignature in MySQL/MariaDB:
# SELECT SHA2(CONCAT(username, '&', password, '&', 'PASTE_AUTHEN_TOKEN_HERE'), 256) AS authenSignature
# FROM user_accounts
# WHERE username = 'afdol';

