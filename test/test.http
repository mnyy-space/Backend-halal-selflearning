### Admin: Create Exercise
POST http://localhost:3000/admin/exercise HTTP/1.1
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjo0LCJ1c2VybmFtZSI6ImFmZG9sIiwiaWF0IjoxNzg0MDk2MTIxLCJleHAiOjE3ODQxODI1MjF9.Ky5e1vvde8esJD1SaaBzF9lJpSeUz_uY3S2b_lRH_Ys

{
    "session_id": 1,
    "exercise_script": "ทดสอบสร้างโจทย์ใหม่ผ่าน REST Client",
    "choices": [
        { "choice_script": "ตัวเลือก 1 (ถูกต้อง)", "isAnswer": 1 },
        { "choice_script": "ตัวเลือก 2 (ไม่ถูกต้อง)", "isAnswer": 0 }
    ]
}

